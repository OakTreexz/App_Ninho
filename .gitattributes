# Normaliza os finais de linha: o repositório guarda LF e some o aviso LF/CRLF no Windows.
* text=auto

*.java       text eol=lf
*.xml        text eol=lf
*.kt         text eol=lf
*.kts        text eol=lf
*.gradle     text eol=lf
*.properties text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
gradlew      text eol=lf
*.bat        text eol=crlf

# Arquivos binários
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.jar  binary
*.pdf  binary
*.ttf  binary
*.otf  binary
